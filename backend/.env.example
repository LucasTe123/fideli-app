PORT=8787
HOST=0.0.0.0
PUBLIC_BASE_URL=https://wallet.tudominio.com

# Opcional: activa la sugerencia de Wallet cuando el cliente esté cerca.
STORE_LATITUDE=-17.000000
STORE_LONGITUDE=-65.000000
STORE_RELEVANT_TEXT=Estás cerca. Presenta tu tarjeta Fideli.

# Apple Wallet: certificados PEM, nunca los copies dentro de Flutter.
APPLE_PASS_TYPE_ID=pass.com.tuempresa.fideli
APPLE_TEAM_ID=XXXXXXXXXX
APPLE_CERT_PATH=/ruta/segura/pass-certificate.pem
APPLE_KEY_PATH=/ruta/segura/pass-private-key.pem
APPLE_WWDR_PATH=/ruta/segura/AppleWWDRCAG4.pem

# Google Wallet: JSON de Service Account fuera del repositorio.
GOOGLE_ISSUER_ID=1234567890123456789
GOOGLE_CLASS_SUFFIX=fideli_loyalty
GOOGLE_SERVICE_ACCOUNT_PATH=/ruta/segura/service-account.json
GOOGLE_LOGO_URL=https://wallet.tudominio.com/assets/icon.png
